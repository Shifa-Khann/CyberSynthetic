# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini
LLM_API_KEY=
# OpenAI-compatible endpoint. Verify the current URL and model name in the provider docs.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
# Secondary provider (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
USE_LLM=true
